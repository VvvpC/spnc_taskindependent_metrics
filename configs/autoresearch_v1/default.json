{
  "schema_version": "1.0",
  "study": {
    "study_id": "heterogeneous_nanodot_autoresearch_v1",
    "title": "Autoresearch V1 for Heterogeneous Nanodot Families"
  },
  "storage": {
    "run_root": "results/raw/autoresearch_v1",
    "processed_root": "results/processed/autoresearch_v1",
    "active_run_pointer": "results/raw/autoresearch_v1/_active_run.json"
  },
  "runtime": {
    "editable_paths": [
      "train.py"
    ],
    "crash_tail_lines": 100
  },
  "summary": {
    "recent_rounds": 5
  },
  "llm": {
    "provider": "openai_compatible",
    "env_file": "configs/autoresearch_v1/kimi.env",
    "api_key_env": [
      "AUTORESEARCH_LLM_API_KEY",
      "MOONSHOT_API_KEY"
    ],
    "base_url_env": [
      "AUTORESEARCH_LLM_BASE_URL",
      "MOONSHOT_BASE_URL"
    ],
    "model_env": [
      "AUTORESEARCH_LLM_MODEL"
    ],
    "default_base_url": "https://api.moonshot.ai/v1",
    "default_model": "kimi-k2-thinking",
    "temperature": 1.0,
    "max_tokens": 16000,
    "timeout_seconds": 300,
    "use_json_mode": false
  },
  "constraints": {
    "beta_prime": {
      "min": 5.0,
      "max": 50.0
    },
    "theta": {
      "min": 0.01,
      "max": 0.8
    },
    "gamma": {
      "min": 0.001,
      "max": 0.3
    },
    "m0": {
      "min": 0.001,
      "max": 0.05
    }
  },
  "evaluator": {
    "mode": "real",
    "nvirt": 25,
    "shared_defaults": {
      "physical": {
        "h": 0.4,
        "theta_H": 90,
        "k_s_0": 0,
        "phi": 45
      },
      "network": {
        "bias": true,
        "Nwarmup": 0
      },
      "simulation": {
        "delay_feedback": 0,
        "voltage_noise": false,
        "johnson_noise": false,
        "thermal_noise": false
      }
    },
    "tims": {
      "mc": {
        "signal_len": 80,
        "delays": 10,
        "splits": [
          0.2,
          0.6
        ]
      },
      "kr_gr": {
        "n_wash": 5,
        "threshold": 0.001
      }
    }
  },
  "scoring": {
    "reference_point": {
      "MC": 0.0,
      "CQ": 0.0
    },
    "normalization": {
      "mode": "fixed_bounds",
      "bounds": {
        "MC": {
          "min": 0.0,
          "max": 10.0
        },
        "CQ": {
          "min": 0.0,
          "max": 100.0
        }
      }
    }
  }
}
